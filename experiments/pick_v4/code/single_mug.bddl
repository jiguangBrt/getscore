(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the white mug and hold it still)
  (:regions
    (porcelain_mug_init_region
      (:target living_room_table)
      (:ranges ((-0.125 -0.175 -0.075 -0.125)))
      (:yaw_rotation ((-0.34906585 0.34906585)))
    )
  )
  (:fixtures living_room_table - living_room_table)
  (:objects porcelain_mug_1 - porcelain_mug)
  (:obj_of_interest porcelain_mug_1)
  (:init (On porcelain_mug_1 living_room_table_porcelain_mug_init_region))
  (:goal (And (On porcelain_mug_1 living_room_table_porcelain_mug_init_region)))
)
